# ─────────────────────────────────────────────
# Africa New Generation (ANG) — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.angfoundation.org

# Contact form email delivery (choose one provider and fill credentials)
CONTACT_FORM_PROVIDER=resend
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=angfoundation1@gmail.com

# Newsletter provider (e.g. Mailchimp, Buttondown) — optional
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# Google Maps (Contact page map embed) — optional, static embed works without a key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics — optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Donation / payment provider — to be configured when donation processing is finalized
DONATION_PROVIDER_PUBLIC_KEY=
DONATION_PROVIDER_SECRET_KEY=

# ─────────────────────────────────────────────
# Admin dashboard (/admin) — see docs/ADMIN.md
# ─────────────────────────────────────────────

# REQUIRED in production. At least 32 random characters; keep it secret, never commit it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out.
ADMIN_SESSION_SECRET=

# Where the admin keeps its data (texts, settings, accounts, activity log) and uploaded images.
# IN PRODUCTION use a folder OUTSIDE the deployed app folder so redeploys never erase it,
# e.g. /home/<your-user>/ang-data . Defaults to ./data in development.
CMS_DATA_DIR=
# Optional: separate folder for uploaded images (default: <CMS_DATA_DIR>/uploads)
CMS_UPLOAD_DIR=
# Optional: maximum upload size in MB (default 8, max 50)
CMS_MAX_UPLOAD_MB=8

# Set to "false" ONLY to test the production build over plain http://. Leave unset behind HTTPS.
# ADMIN_COOKIE_SECURE=false

# Create the FIRST administrator without a terminal (only used while no account exists).
# Set all three, deploy, sign in once at /admin/login, then DELETE these three variables.
# ADMIN_BOOTSTRAP_EMAIL=you@example.org
# ADMIN_BOOTSTRAP_NAME=Your Name
# ADMIN_BOOTSTRAP_PASSWORD=at-least-12-characters
